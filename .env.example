# Copy to .env and fill in. Never commit the real file.

# --- core -------------------------------------------------------------------
HOSTPLANE_ENV=development
HOSTPLANE_DEBUG=false
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
HOSTPLANE_SECRET_KEY=dev-insecure-secret-change-me
HOSTPLANE_BASE_URL=http://localhost:8000

# --- database and broker ----------------------------------------------------
HOSTPLANE_DATABASE_URL=postgresql+psycopg://hostplane:hostplane@localhost:5432/hostplane
HOSTPLANE_REDIS_URL=redis://localhost:6379/0

# --- hypervisor -------------------------------------------------------------
# "mock" runs the whole platform with no hypervisor at all. Switch to "vsphere"
# once a vCenter is reachable and templates are prepared.
HOSTPLANE_DRIVER=mock
HOSTPLANE_VSPHERE_HOST=
HOSTPLANE_VSPHERE_USER=
HOSTPLANE_VSPHERE_PASSWORD=
HOSTPLANE_VSPHERE_PORT=443
# Leave verification enabled. For a private CA, point the bundle at its PEM
# rather than turning this off — production config refuses to boot with it off.
HOSTPLANE_VSPHERE_VERIFY_SSL=true
HOSTPLANE_VSPHERE_CA_BUNDLE=
HOSTPLANE_VSPHERE_TASK_TIMEOUT_SECONDS=1800

# --- console ---
# "vcenter" hands off to vCenter's own HTML5 console — no extra assets needed,
# but it exposes the vCenter hostname to the customer. "webmks" serves a
# self-hosted viewer and needs VMware's wmks.js from the vSphere HTML Console
# SDK, which is not redistributable: download it, serve it, and point
# HOSTPLANE_CONSOLE_WMKS_PATH at its URL.
HOSTPLANE_CONSOLE_MODE=vcenter
HOSTPLANE_CONSOLE_WMKS_PATH=

# --- IPAM -------------------------------------------------------------------
# Hours a released address is held before reissue, so a new customer does not
# inherit the previous tenant's traffic or blocklist reputation.
HOSTPLANE_IP_QUARANTINE_HOURS=24

# --- billing ----------------------------------------------------------------
HOSTPLANE_CURRENCY=EUR
HOSTPLANE_PAYMENT_GATEWAY=fake
HOSTPLANE_GATEWAY_WEBHOOK_SECRET=dev-webhook-secret
HOSTPLANE_INVOICE_DUE_DAYS=7
# Days after going past due to retry payment, before suspension.
HOSTPLANE_DUNNING_RETRY_DAYS=1,3,7
# Days a suspended server is kept before it is deleted permanently.
HOSTPLANE_TERMINATE_AFTER_SUSPEND_DAYS=14

# --- quotas -----------------------------------------------------------------
HOSTPLANE_DEFAULT_MAX_INSTANCES=5
HOSTPLANE_DEFAULT_MAX_IPS=5
